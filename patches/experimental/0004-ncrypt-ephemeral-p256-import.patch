+/* Named public P-256 imports are ephemeral. Other curves, private blobs and
+ * parameter types remain unsupported; never ignore an import descriptor. */
+static SECURITY_STATUS import_p256_public(NCRYPT_PROV_HANDLE provider, const WCHAR *type,
+                                          NCryptBufferDesc *params, NCRYPT_KEY_HANDLE *handle,
+                                          BYTE *data, DWORD datasize)
+{
+    struct { BCRYPT_ECCKEY_BLOB header; BYTE point[64]; } blob;
+    NCRYPT_KEY_HANDLE imported;
+    struct object *object;
+    SECURITY_STATUS ret;
+    BOOL named = FALSE;
+
+    if (!((struct object *)provider)->storage_provider.software) return NTE_NOT_SUPPORTED;
+    if (lstrcmpW(type, BCRYPT_ECCPUBLIC_BLOB)) return NTE_NOT_SUPPORTED;
+    if (datasize != sizeof(blob)) return NTE_INVALID_PARAMETER;
+    memcpy(&blob, data, sizeof(blob));
+    if (blob.header.cbKey != 32) return NTE_INVALID_PARAMETER;
+    if (params)
+    {
+        NCryptBuffer *buffer;
+        WCHAR curve[256];
+        if (params->ulVersion != NCRYPTBUFFER_VERSION || params->cBuffers > 1)
+            return NTE_INVALID_PARAMETER;
+        if (params->cBuffers)
+        {
+            if (!(buffer = params->pBuffers)) return NTE_INVALID_PARAMETER;
+            if (buffer->BufferType != NCRYPTBUFFER_ECC_CURVE_NAME) return NTE_NOT_SUPPORTED;
+            if (!buffer->pvBuffer || buffer->cbBuffer < sizeof(WCHAR) ||
+                buffer->cbBuffer > sizeof(curve) || buffer->cbBuffer % sizeof(WCHAR))
+                return NTE_INVALID_PARAMETER;
+            memcpy(curve, buffer->pvBuffer, buffer->cbBuffer);
+            if (curve[buffer->cbBuffer / sizeof(WCHAR) - 1]) return NTE_INVALID_PARAMETER;
+            if (buffer->cbBuffer != sizeof(L"nistP256") || lstrcmpiW(curve, L"nistP256"))
+                return NTE_NOT_SUPPORTED;
+            named = TRUE;
+        }
+    }
+    if (blob.header.dwMagic == BCRYPT_ECDSA_PUBLIC_GENERIC_MAGIC && !named)
+        return NTE_INVALID_PARAMETER;
+    /* The pinned BCrypt backend supports the specific P-256 format. Normalize
+     * only our local copy after checking the caller's curve and exact shape. */
+    blob.header.dwMagic = BCRYPT_ECDSA_PUBLIC_P256_MAGIC;
+    if ((ret = create_p256_key(provider, &imported, FALSE))) return ret;
+    object = (struct object *)imported;
+    ret = map_ntstatus(BCryptImportKeyPair(BCRYPT_ECDSA_P256_ALG_HANDLE, NULL, BCRYPT_ECCPUBLIC_BLOB,
+                       &object->key.bcrypt_key, (BYTE *)&blob, sizeof(blob), 0));
+    if (!ret)
+        ret = set_object_property(object, NCRYPT_ECC_CURVE_NAME_PROPERTY,
+                                  (BYTE *)L"nistP256", sizeof(L"nistP256"));
+    if (ret)
+    {
+        free_unpublished_object(object);
+        return ret;
+    }
+    object->key.public_import = object->key.material_finalized = object->key.finalized = TRUE;
+    *handle = imported;
+    return ERROR_SUCCESS;
+}
