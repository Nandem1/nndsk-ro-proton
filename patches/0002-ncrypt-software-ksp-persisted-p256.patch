@@ -0,0 +1,265 @@
+/*
+ * Software KSP named P256 storage. All material/metadata is one protected value.
+ * Existing Wine DPAPI is reused; this is not Windows LSA or TPM isolation.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "wincrypt.h"
+#include "ncrypt.h"
+#include "bcrypt.h"
+#include "ncrypt_internal.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(ncrypt);
+
+static const WCHAR storage_path[] = L"Software\\Wine\\Crypto\\CNG\\SoftwareKSP\\Keys";
+static const WCHAR storage_mutex[] = L"Local\\Wine.NCrypt.SoftwareKSP.PersistentKeys.v1";
+#define MAX_NAME_CHARS 1024
+#define MAX_PROTECTED_SIZE 65536
+#define RECORD_MAGIC 0x31474e43 /* CNG1, little-endian */
+
+/* Fixed-width format shared by PE32 and PE64; no pointers or opaque handles. */
+struct record_header
+{
+    DWORD magic, version, algorithm, length, scope, policy, usage, name_chars, blob_size;
+    BYTE generation[16];
+};
+C_ASSERT(sizeof(struct record_header) == 52);
+
+static SECURITY_STATUS storage_error(LSTATUS error)
+{
+    switch (error)
+    {
+    case ERROR_SUCCESS: return ERROR_SUCCESS;
+    case ERROR_FILE_NOT_FOUND: return NTE_BAD_KEYSET;
+    case ERROR_ACCESS_DENIED: return NTE_PERM;
+    case ERROR_NOT_ENOUGH_MEMORY:
+    case ERROR_OUTOFMEMORY: return NTE_NO_MEMORY;
+    default: return NTE_INTERNAL_ERROR;
+    }
+}
+
+static SECURITY_STATUS acquire_storage(HANDLE *mutex)
+{
+    DWORD wait;
+    if (!(*mutex = CreateMutexW(NULL, FALSE, storage_mutex))) return storage_error(GetLastError());
+    wait = WaitForSingleObject(*mutex, INFINITE);
+    if (wait == WAIT_OBJECT_0 || wait == WAIT_ABANDONED) return ERROR_SUCCESS;
+    CloseHandle(*mutex);
+    *mutex = NULL;
+    return NTE_INTERNAL_ERROR;
+}
+
+static void release_storage(HANDLE mutex)
+{
+    ReleaseMutex(mutex);
+    CloseHandle(mutex);
+}
+
+static SECURITY_STATUS open_storage(DWORD flags, BOOL create, REGSAM access, HKEY *root)
+{
+    HKEY hive = flags & NCRYPT_MACHINE_KEY_FLAG ? HKEY_LOCAL_MACHINE : HKEY_CURRENT_USER;
+    LSTATUS status;
+    /* The same store is visible to PE32 and PE64, including the HKLM namespace. */
+    access |= KEY_WOW64_64KEY;
+    if (create)
+        status = RegCreateKeyExW(hive, storage_path, 0, NULL, 0, access, NULL, root, NULL);
+    else
+        status = RegOpenKeyExW(hive, storage_path, 0, access, root);
+    return storage_error(status);
+}
+
+static SECURITY_STATUS read_value(HKEY root, const WCHAR *name, DATA_BLOB *data)
+{
+    DWORD type, size = 0;
+    LSTATUS status;
+    status = RegQueryValueExW(root, name, NULL, &type, NULL, &size);
+    if (status) return storage_error(status);
+    if (type != REG_BINARY || !size || size > MAX_PROTECTED_SIZE) return NTE_BAD_DATA;
+    if (!(data->pbData = malloc(size))) return NTE_NO_MEMORY;
+    data->cbData = size;
+    status = RegQueryValueExW(root, name, NULL, &type, data->pbData, &data->cbData);
+    if (status || type != REG_BINARY || data->cbData != size)
+    {
+        free(data->pbData);
+        data->pbData = NULL;
+        return status ? storage_error(status) : NTE_BAD_DATA;
+    }
+    return ERROR_SUCCESS;
+}
+
+static SECURITY_STATUS decode_value(const DATA_BLOB *protected, const WCHAR *name, DWORD flags,
+                                    struct persisted_key *key)
+{
+    DATA_BLOB clear = {0}, input = *protected;
+    const struct record_header *header;
+    const WCHAR *stored_name;
+    BCRYPT_ECCKEY_BLOB blob_header;
+    SECURITY_STATUS ret = NTE_BAD_DATA;
+    DWORD chars = wcslen(name) + 1, i;
+
+    if (!CryptUnprotectData(&input, NULL, NULL, NULL, NULL, CRYPTPROTECT_UI_FORBIDDEN, &clear))
+        return GetLastError() == ERROR_OUTOFMEMORY ? NTE_NO_MEMORY : NTE_BAD_DATA;
+    if (clear.cbData < sizeof(*header)) goto done;
+    header = (const struct record_header *)clear.pbData;
+    if (header->magic != RECORD_MAGIC || header->version != 1 || header->algorithm != 1 ||
+        header->length != 256 || header->scope != (flags & NCRYPT_MACHINE_KEY_FLAG) ||
+        header->name_chars != chars || chars > MAX_NAME_CHARS ||
+        header->blob_size != sizeof(key->private_blob) ||
+        clear.cbData != sizeof(*header) + chars * sizeof(WCHAR) + sizeof(key->private_blob)) goto done;
+    if (header->policy & ~(NCRYPT_ALLOW_EXPORT_FLAG | NCRYPT_ALLOW_PLAINTEXT_EXPORT_FLAG)) goto done;
+    if (header->usage != NCRYPT_ALLOW_ALL_USAGES && (header->usage & ~NCRYPT_ALLOW_SIGNING_FLAG)) goto done;
+    stored_name = (const WCHAR *)(header + 1);
+    if (stored_name[chars - 1]) goto done;
+    for (i = 0; i < chars - 1; ++i) if (!stored_name[i]) goto done;
+    if (lstrcmpiW(stored_name, name)) goto done;
+    memcpy(&blob_header, (const BYTE *)stored_name + chars * sizeof(WCHAR), sizeof(blob_header));
+    if (blob_header.dwMagic != BCRYPT_ECDSA_PRIVATE_P256_MAGIC || blob_header.cbKey != 32) goto done;
+    key->policy = header->policy;
+    key->usage = header->usage;
+    memcpy(key->generation, header->generation, sizeof(key->generation));
+    memcpy(key->private_blob, (const BYTE *)stored_name + chars * sizeof(WCHAR), sizeof(key->private_blob));
+    ret = ERROR_SUCCESS;
+done:
+    SecureZeroMemory(clear.pbData, clear.cbData);
+    LocalFree(clear.pbData);
+    return ret;
+}
+
+SECURITY_STATUS ncrypt_storage_check(const WCHAR *name, DWORD flags)
+{
+    SECURITY_STATUS ret;
+    HANDLE mutex;
+    HKEY root;
+    LSTATUS status;
+    if (!name[0] || wcslen(name) >= MAX_NAME_CHARS) return NTE_INVALID_PARAMETER;
+    if ((ret = acquire_storage(&mutex))) return ret;
+    ret = open_storage(flags, FALSE, KEY_QUERY_VALUE, &root);
+    if (!ret)
+    {
+        status = RegQueryValueExW(root, name, NULL, NULL, NULL, NULL);
+        ret = status == ERROR_SUCCESS ? NTE_EXISTS : storage_error(status);
+        RegCloseKey(root);
+    }
+    release_storage(mutex);
+    if (ret == NTE_BAD_KEYSET || (ret == NTE_EXISTS && (flags & NCRYPT_OVERWRITE_KEY_FLAG))) return ERROR_SUCCESS;
+    return ret;
+}
+
+SECURITY_STATUS ncrypt_storage_read(const WCHAR *name, DWORD flags, struct persisted_key *key)
+{
+    SECURITY_STATUS ret;
+    HANDLE mutex;
+    HKEY root;
+    DATA_BLOB value = {0};
+    if (!name[0] || wcslen(name) >= MAX_NAME_CHARS) return NTE_INVALID_PARAMETER;
+    if ((ret = acquire_storage(&mutex))) return ret;
+    if (!(ret = open_storage(flags, FALSE, KEY_QUERY_VALUE, &root)))
+    {
+        ret = read_value(root, name, &value);
+        if (!ret) ret = decode_value(&value, name, flags, key);
+        free(value.pbData);
+        RegCloseKey(root);
+    }
+    release_storage(mutex);
+    return ret;
+}
+
+/* Caller owns the mutex. Restore the old complete value on an observed flush failure. */
+static SECURITY_STATUS commit_value(HKEY root, const WCHAR *name, const DATA_BLOB *next,
+                                    const DATA_BLOB *previous)
+{
+    LSTATUS status, rollback;
+    if (next)
+        status = RegSetValueExW(root, name, 0, REG_BINARY, next->pbData, next->cbData);
+    else
+        status = RegDeleteValueW(root, name);
+    if (status) return storage_error(status);
+    if (!(status = RegFlushKey(root))) return ERROR_SUCCESS;
+    if (previous && previous->pbData)
+        rollback = RegSetValueExW(root, name, 0, REG_BINARY, previous->pbData, previous->cbData);
+    else
+        rollback = RegDeleteValueW(root, name);
+    if (!rollback) rollback = RegFlushKey(root);
+    if (rollback) ERR("Persistent key publication rollback failed: %ld\n", rollback);
+    return storage_error(status);
+}
+
+SECURITY_STATUS ncrypt_storage_write(const struct key *key, DWORD policy, DWORD usage)
+{
+    struct record_header *header;
+    DATA_BLOB clear = {0}, protected = {0}, previous = {0};
+    DWORD size, chars = wcslen(key->name) + 1, dpapi_flags = CRYPTPROTECT_UI_FORBIDDEN;
+    SECURITY_STATUS ret = NTE_INTERNAL_ERROR;
+    HANDLE mutex;
+    HKEY root;
+
+    clear.cbData = sizeof(*header) + chars * sizeof(WCHAR) + 104;
+    if (!(clear.pbData = calloc(1, clear.cbData))) return NTE_NO_MEMORY;
+    header = (struct record_header *)clear.pbData;
+    header->magic = RECORD_MAGIC;
+    header->version = header->algorithm = 1;
+    header->length = 256;
+    header->scope = key->storage_flags & NCRYPT_MACHINE_KEY_FLAG;
+    header->policy = policy;
+    header->usage = usage;
+    header->name_chars = chars;
+    header->blob_size = 104;
+    memcpy(header->generation, key->generation, sizeof(header->generation));
+    memcpy(header + 1, key->name, chars * sizeof(WCHAR));
+    if (BCryptExportKey(key->bcrypt_key, NULL, BCRYPT_ECCPRIVATE_BLOB,
+        clear.pbData + sizeof(*header) + chars * sizeof(WCHAR), 104, &size, 0) || size != 104) goto done;
+    if (header->scope) dpapi_flags |= CRYPTPROTECT_LOCAL_MACHINE;
+    if (!CryptProtectData(&clear, NULL, NULL, NULL, NULL, dpapi_flags, &protected))
+    {
+        ret = GetLastError() == ERROR_OUTOFMEMORY ? NTE_NO_MEMORY : NTE_INTERNAL_ERROR;
+        goto done;
+    }
+    if (!protected.cbData || protected.cbData > MAX_PROTECTED_SIZE) goto done;
+    if ((ret = acquire_storage(&mutex))) goto done;
+    if (!(ret = open_storage(key->storage_flags, TRUE, KEY_QUERY_VALUE | KEY_SET_VALUE, &root)))
+    {
+        ret = read_value(root, key->name, &previous);
+        if (!ret && !(key->storage_flags & NCRYPT_OVERWRITE_KEY_FLAG)) ret = NTE_EXISTS;
+        else if (!ret || ret == NTE_BAD_KEYSET) ret = commit_value(root, key->name, &protected, &previous);
+        RegCloseKey(root);
+    }
+    release_storage(mutex);
+done:
+    SecureZeroMemory(clear.pbData, clear.cbData);
+    free(clear.pbData);
+    LocalFree(protected.pbData);
+    free(previous.pbData);
+    return ret;
+}
+
+SECURITY_STATUS ncrypt_storage_delete(const struct key *key)
+{
+    struct persisted_key stored = {0};
+    DATA_BLOB previous = {0};
+    SECURITY_STATUS ret;
+    HANDLE mutex;
+    HKEY root;
+    if ((ret = acquire_storage(&mutex))) return ret;
+    if (!(ret = open_storage(key->storage_flags, FALSE, KEY_QUERY_VALUE | KEY_SET_VALUE, &root)))
+    {
+        ret = read_value(root, key->name, &previous);
+        if (!ret) ret = decode_value(&previous, key->name, key->storage_flags, &stored);
+        if (!ret && memcmp(stored.generation, key->generation, sizeof(key->generation))) ret = NTE_BAD_KEYSET;
+        if (!ret) ret = commit_value(root, key->name, NULL, &previous);
+        free(previous.pbData);
+        RegCloseKey(root);
+    }
+    SecureZeroMemory(&stored, sizeof(stored));
+    release_storage(mutex);
+    return ret;
+}
