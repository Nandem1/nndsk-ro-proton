+static void test_ephemeral_p256(void)
+{
+    NCRYPT_PROV_HANDLE prov;
+    NCRYPT_KEY_HANDLE key;
+    SECURITY_STATUS ret;
+    DWORD size, value;
+    WCHAR group[16];
+    BYTE public_blob[72], private_blob[104], signature[64], hash[32] = {0};
+    BYTE untouched[104];
+
+    ret = NCryptOpenStorageProvider(&prov, NULL, 0);
+    ok(!ret, "Open provider failed %#lx\n", ret);
+    if (ret) return;
+    ret = NCryptCreatePersistedKey(prov, &key, BCRYPT_ECDSA_P256_ALGORITHM, NULL, 0, 0);
+    ok(!ret, "Create ephemeral P256 failed %#lx\n", ret);
+    if (ret) goto done;
+
+    ret = NCryptGetProperty(key, NCRYPT_LENGTH_PROPERTY, (BYTE *)&value, sizeof(value), &size, 0);
+    ok(!ret && value == 256 && size == sizeof(value), "Length: ret %#lx value %lu size %lu\n", ret, value, size);
+    ret = NCryptGetProperty(key, NCRYPT_ALGORITHM_GROUP_PROPERTY, (BYTE *)group, sizeof(group), &size, 0);
+    ok(!ret && !lstrcmpW(group, L"ECDSA"), "Algorithm group: %#lx\n", ret);
+    value = 0;
+    ret = NCryptSetProperty(key, NCRYPT_EXPORT_POLICY_PROPERTY, (BYTE *)&value, sizeof(value), 0);
+    ok(!ret, "Set no-export policy failed %#lx\n", ret);
+
+    ret = NCryptExportKey(key, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, public_blob, sizeof(public_blob), &size, 0);
+    ok(ret != ERROR_SUCCESS, "Unfinalized export unexpectedly succeeded\n");
+    ret = NCryptFinalizeKey(key, NCRYPT_SILENT_FLAG);
+    ok(!ret, "Finalize P256 failed %#lx\n", ret);
+    if (ret) goto free_key;
+
+    size = 0;
+    ret = NCryptExportKey(key, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, NULL, 0, &size, NCRYPT_SILENT_FLAG);
+    ok(!ret && size == sizeof(public_blob), "Public size query: %#lx size %lu\n", ret, size);
+    memset(untouched, 0xcc, sizeof(untouched));
+    memset(private_blob, 0xcc, sizeof(private_blob));
+    ret = NCryptExportKey(key, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, private_blob, sizeof(public_blob) - 1, &size, 0);
+    ok(ret != ERROR_SUCCESS && size == sizeof(public_blob), "Short public export: %#lx size %lu\n", ret, size);
+    ok(!memcmp(private_blob, untouched, sizeof(private_blob)), "Short export modified buffer\n");
+    ret = NCryptExportKey(key, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, public_blob, sizeof(public_blob), &size, 0);
+    ok(!ret && size == sizeof(public_blob), "Public export: %#lx size %lu\n", ret, size);
+    if (!ret)
+    {
+        BCRYPT_ECCKEY_BLOB *header = (BCRYPT_ECCKEY_BLOB *)public_blob;
+        ok(header->dwMagic == BCRYPT_ECDSA_PUBLIC_P256_MAGIC && header->cbKey == 32,
+           "Wrong ECC header %#lx / %lu\n", header->dwMagic, header->cbKey);
+    }
+    ret = NCryptExportKey(key, 0, BCRYPT_ECCPRIVATE_BLOB, NULL, private_blob, sizeof(private_blob), &size, 0);
+    ok(ret != ERROR_SUCCESS, "Private export with policy zero succeeded\n");
+    ok(!memcmp(private_blob, untouched, sizeof(private_blob)), "Denied export modified buffer\n");
+    ret = NCryptExportKey(key, 0, BCRYPT_PRIVATE_KEY_BLOB, NULL, private_blob, sizeof(private_blob), &size, 0);
+    ok(ret != ERROR_SUCCESS, "Generic private alias escaped export policy\n");
+    ok(!memcmp(private_blob, untouched, sizeof(private_blob)), "Denied alias modified buffer\n");
+
+    ret = NCryptSignHash(key, NULL, hash, sizeof(hash), signature, sizeof(signature), &size, NCRYPT_SILENT_FLAG);
+    ok(!ret && size == sizeof(signature), "Sign P256: %#lx size %lu\n", ret, size);
+    if (!ret)
+    {
+        ret = NCryptVerifySignature(key, NULL, hash, sizeof(hash), signature, size, 0);
+        ok(!ret, "Verify P256 failed %#lx\n", ret);
+        hash[0] ^= 1;
+        ret = NCryptVerifySignature(key, NULL, hash, sizeof(hash), signature, size, 0);
+        ok(ret != ERROR_SUCCESS, "Changed hash was accepted\n");
+    }
+
+free_key:
+    ret = NCryptFreeObject(key);
+    ok(!ret, "Free P256 key failed %#lx\n", ret);
+    ret = NCryptCreatePersistedKey(prov, &key, BCRYPT_ECDSA_P256_ALGORITHM, NULL, 0, 0);
+    ok(!ret, "Create exportable P256 failed %#lx\n", ret);
+    if (ret) goto done;
+    value = NCRYPT_ALLOW_EXPORT_FLAG | NCRYPT_ALLOW_PLAINTEXT_EXPORT_FLAG;
+    ret = NCryptSetProperty(key, NCRYPT_EXPORT_POLICY_PROPERTY, (BYTE *)&value, sizeof(value), 0);
+    ok(!ret, "Set export policy failed %#lx\n", ret);
+    ret = NCryptFinalizeKey(key, 0);
+    ok(!ret, "Finalize exportable P256 failed %#lx\n", ret);
+    if (!ret)
+    {
+        ret = NCryptExportKey(key, 0, BCRYPT_ECCPRIVATE_BLOB, NULL, private_blob, sizeof(private_blob), &size, 0);
+        ok(!ret && size == sizeof(private_blob), "Allowed export: %#lx size %lu\n", ret, size);
+    }
+    SecureZeroMemory(private_blob, sizeof(private_blob));
+    ret = NCryptFreeObject(key);
+    ok(!ret, "Free exportable key failed %#lx\n", ret);
+done:
+    ret = NCryptFreeObject(prov);
+    ok(!ret, "Free provider failed %#lx\n", ret);
+}
+
+static void test_named_p256(void)
+{
+    NCRYPT_PROV_HANDLE prov;
+    NCRYPT_KEY_HANDLE key = 0, duplicate = 0, old = 0, pending = 0;
+    WCHAR name[80], returned[80];
+    BYTE public_before[72], public_after[72], private_blob[104], untouched[104];
+    DWORD size, value;
+    SECURITY_STATUS ret;
+
+    swprintf(name, ARRAY_SIZE(name), L"Wine.ncrypt.P256.%lu", GetCurrentProcessId());
+    ret = NCryptOpenStorageProvider(&prov, NULL, 0);
+    ok(!ret, "Open provider failed %#lx\n", ret);
+    if (ret) return;
+    ret = NCryptOpenKey(prov, &key, name, 0, NCRYPT_SILENT_FLAG);
+    ok(ret == NTE_BAD_KEYSET, "Missing named key: %#lx\n", ret);
+    if (!ret) goto done; /* Never adopt/delete an unexpected existing key. */
+    key = 0;
+
+    ret = NCryptCreatePersistedKey(prov, &key, BCRYPT_ECDSA_P256_ALGORITHM, name, 0, 0);
+    ok(!ret, "Create abandoned key: %#lx\n", ret);
+    if (ret) goto done;
+    ret = NCryptFreeObject(key);
+    key = 0;
+    ok(!ret, "Free unfinalized key: %#lx\n", ret);
+    ret = NCryptOpenKey(prov, &key, name, 0, 0);
+    ok(ret == NTE_BAD_KEYSET, "Unfinalized abandoned key persisted: %#lx\n", ret);
+    if (!ret) goto done;
+    key = 0;
+
+    ret = NCryptCreatePersistedKey(prov, &key, BCRYPT_ECDSA_P256_ALGORITHM, name, 0, 0);
+    ok(!ret, "Create named P256: %#lx\n", ret);
+    if (ret) goto done;
+    ret = NCryptGetProperty(key, NCRYPT_NAME_PROPERTY, (BYTE *)returned, sizeof(returned), &size, 0);
+    ok(!ret && !lstrcmpW(returned, name), "Name property: %#lx\n", ret);
+    value = 0;
+    ret = NCryptSetProperty(key, NCRYPT_EXPORT_POLICY_PROPERTY, (BYTE *)&value, sizeof(value), 0);
+    ok(!ret, "Set policy zero: %#lx\n", ret);
+    ret = NCryptFinalizeKey(key, NCRYPT_SILENT_FLAG);
+    ok(!ret, "Finalize named P256: %#lx\n", ret);
+    if (ret) goto done;
+    ret = NCryptExportKey(key, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, public_before, sizeof(public_before), &size, 0);
+    ok(!ret && size == sizeof(public_before), "Export original public: %#lx / %lu\n", ret, size);
+    ret = NCryptCreatePersistedKey(prov, &duplicate, BCRYPT_ECDSA_P256_ALGORITHM, name, 0, 0);
+    ok(ret == NTE_EXISTS, "Duplicate create: %#lx\n", ret);
+    if (!ret) NCryptFreeObject(duplicate);
+    ret = NCryptFreeObject(key);
+    key = 0;
+    ok(!ret, "Free without deleting: %#lx\n", ret);
+
+    ret = NCryptOpenKey(prov, &key, name, 0, NCRYPT_SILENT_FLAG);
+    ok(!ret, "Reopen named P256: %#lx\n", ret);
+    if (ret) goto done;
+    ret = NCryptExportKey(key, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, public_after, sizeof(public_after), &size, 0);
+    ok(!ret && size == sizeof(public_after), "Export reopened public: %#lx / %lu\n", ret, size);
+    ok(!memcmp(public_before, public_after, sizeof(public_before)), "Public key changed after reopen\n");
+    value = 9;
+    ret = NCryptGetProperty(key, NCRYPT_EXPORT_POLICY_PROPERTY, (BYTE *)&value, sizeof(value), &size, 0);
+    ok(!ret && value == 0, "Persisted policy: %#lx / %lu\n", ret, value);
+    memset(private_blob, 0xcc, sizeof(private_blob));
+    memset(untouched, 0xcc, sizeof(untouched));
+    ret = NCryptExportKey(key, 0, BCRYPT_ECCPRIVATE_BLOB, NULL, private_blob, sizeof(private_blob), &size, 0);
+    ok(ret != ERROR_SUCCESS, "Reopened private escaped policy zero\n");
+    ok(!memcmp(private_blob, untouched, sizeof(private_blob)), "Denied export wrote bytes\n");
+    ret = NCryptDeleteKey(key, NCRYPT_SILENT_FLAG);
+    ok(!ret, "Delete named key: %#lx\n", ret);
+    if (ret) goto done;
+    key = 0; /* Successful Delete consumes handle. */
+    ret = NCryptOpenKey(prov, &key, name, 0, 0);
+    ok(ret == NTE_BAD_KEYSET, "Open after delete: %#lx\n", ret);
+    if (!ret) goto done;
+    key = 0;
+
+    /* Failed publication must neither replace the winner nor become usable. */
+    ret = NCryptCreatePersistedKey(prov, &key, BCRYPT_ECDSA_P256_ALGORITHM, name, 0, 0);
+    ok(!ret, "Create first pending key: %#lx\n", ret);
+    if (ret) goto done;
+    ret = NCryptCreatePersistedKey(prov, &pending, BCRYPT_ECDSA_P256_ALGORITHM, name, 0, 0);
+    ok(!ret || ret == NTE_EXISTS, "Create second pending key: %#lx\n", ret);
+    if (ret) pending = 0;
+    ret = NCryptFinalizeKey(key, 0);
+    ok(!ret, "Finalize first pending key: %#lx\n", ret);
+    if (ret) goto done;
+    if (pending)
+    {
+        ret = NCryptFinalizeKey(pending, 0);
+        ok(ret == NTE_EXISTS, "Colliding finalization: %#lx\n", ret);
+        ret = NCryptExportKey(pending, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, public_after, sizeof(public_after), &size, 0);
+        ok(ret != ERROR_SUCCESS, "Failed publication became usable\n");
+        ret = NCryptFreeObject(pending);
+        pending = 0;
+        ok(!ret, "Free failed publication: %#lx\n", ret);
+    }
+    ret = NCryptExportKey(key, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, public_before, sizeof(public_before), &size, 0);
+    ok(!ret, "Export winner: %#lx\n", ret);
+    old = key;
+    key = 0;
+    ret = NCryptCreatePersistedKey(prov, &key, BCRYPT_ECDSA_P256_ALGORITHM, name, 0, NCRYPT_OVERWRITE_KEY_FLAG);
+    ok(!ret, "Create overwrite: %#lx\n", ret);
+    if (ret) goto done;
+    ret = NCryptFinalizeKey(key, 0);
+    ok(!ret, "Finalize overwrite: %#lx\n", ret);
+    if (ret) goto done;
+    ret = NCryptExportKey(key, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, public_after, sizeof(public_after), &size, 0);
+    ok(!ret, "Export replacement: %#lx\n", ret);
+    ok(memcmp(public_before, public_after, sizeof(public_before)), "Overwrite did not generate a different key\n");
+    ret = NCryptDeleteKey(old, 0);
+    ok(ret != ERROR_SUCCESS, "Stale handle deleted replacement\n");
+    if (!ret) old = 0;
+    ret = NCryptOpenKey(prov, &duplicate, name, 0, 0);
+    ok(!ret, "Stale delete lost replacement: %#lx\n", ret);
+    if (!ret)
+    {
+        ret = NCryptExportKey(duplicate, 0, BCRYPT_ECCPUBLIC_BLOB, NULL, public_before, sizeof(public_before), &size, 0);
+        ok(!ret && !memcmp(public_before, public_after, sizeof(public_before)), "Replacement changed: %#lx\n", ret);
+        NCryptFreeObject(duplicate);
+    }
+    ret = NCryptDeleteKey(key, 0);
+    ok(!ret, "Delete replacement: %#lx\n", ret);
+    if (!ret) key = 0;
+done:
+    if (pending) NCryptFreeObject(pending);
+    if (old) NCryptFreeObject(old);
+    if (key) NCryptFreeObject(key);
+    NCryptFreeObject(prov);
+}
