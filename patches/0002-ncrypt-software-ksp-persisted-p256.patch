+static SECURITY_STATUS create_p256_key(NCRYPT_PROV_HANDLE provider, NCRYPT_KEY_HANDLE *key, BOOL generate)
+{
+    const NCRYPT_SUPPORTED_LENGTHS lengths = {256, 256, 0, 256};
+    const DWORD bitlen = 256, siglen = 64, zero = 0, usage = NCRYPT_ALLOW_ALL_USAGES;
+    const struct
+    {
+        const WCHAR *name;
+        const void *data;
+        DWORD size;
+    } properties[] =
+    {
+        {NCRYPT_ALGORITHM_PROPERTY, BCRYPT_ECDSA_P256_ALGORITHM, sizeof(BCRYPT_ECDSA_P256_ALGORITHM)},
+        {NCRYPT_ALGORITHM_GROUP_PROPERTY, L"ECDSA", sizeof(L"ECDSA")},
+        {NCRYPT_LENGTH_PROPERTY, &bitlen, sizeof(bitlen)},
+        {NCRYPT_LENGTHS_PROPERTY, &lengths, sizeof(lengths)},
+        {BCRYPT_PUBLIC_KEY_LENGTH, &bitlen, sizeof(bitlen)},
+        {BCRYPT_SIGNATURE_LENGTH, &siglen, sizeof(siglen)},
+        {NCRYPT_EXPORT_POLICY_PROPERTY, &zero, sizeof(zero)},
+        {NCRYPT_KEY_USAGE_PROPERTY, &usage, sizeof(usage)},
+        {NCRYPT_KEY_TYPE_PROPERTY, &zero, sizeof(zero)},
+        {NCRYPT_PROVIDER_HANDLE_PROPERTY, &provider, sizeof(provider)},
+    };
+    struct object *object;
+    SECURITY_STATUS ret;
+    unsigned int i;
+
+    if (!(object = allocate_object(KEY))) return NTE_NO_MEMORY;
+    object->key.algid = ECDSA;
+    for (i = 0; i < ARRAY_SIZE(properties); i++)
+    {
+        ret = set_object_property(object, properties[i].name, (BYTE *)properties[i].data, properties[i].size);
+        if (ret) goto failed;
+    }
+    if (generate)
+    {
+        ret = map_ntstatus(BCryptGenerateKeyPair(BCRYPT_ECDSA_P256_ALG_HANDLE, &object->key.bcrypt_key, 256, 0));
+        if (ret) goto failed;
+    }
+    *key = (NCRYPT_KEY_HANDLE)object;
+    return ERROR_SUCCESS;
+
+failed:
+    for (i = 0; i < object->num_properties; i++)
+    {
+        free(object->properties[i].key);
+        free(object->properties[i].value);
+    }
+    free(object->properties);
+    free(object);
+    return ret;
+}
+
+static SECURITY_STATUS set_named_key_properties(struct object *object, const WCHAR *name, DWORD flags)
+{
+    DWORD scope = flags & NCRYPT_MACHINE_KEY_FLAG;
+    SECURITY_STATUS ret;
+    if (!(object->key.name = wcsdup(name))) return NTE_NO_MEMORY;
+    object->key.storage_flags = flags;
+    ret = set_object_property(object, NCRYPT_NAME_PROPERTY, (BYTE *)name, (wcslen(name) + 1) * sizeof(WCHAR));
+    if (!ret) ret = set_object_property(object, NCRYPT_KEY_TYPE_PROPERTY, (BYTE *)&scope, sizeof(scope));
+    return ret;
+}
+
+/* Internal construction cleanup must not relax the public handle contract. */
+static void free_unpublished_object(struct object *object)
+{
+    unsigned int i;
+    if (object->key.bcrypt_key) BCryptDestroyKey(object->key.bcrypt_key);
+    free(object->key.name);
+    for (i = 0; i < object->num_properties; ++i)
+    {
+        free(object->properties[i].key);
+        free(object->properties[i].value);
+    }
+    free(object->properties);
+    free(object);
+}
