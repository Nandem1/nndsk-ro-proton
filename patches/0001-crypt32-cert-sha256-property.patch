+static void testCertSha256Property(void)
+{
+    PCCERT_CONTEXT context;
+    BYTE expected[32] = {0}, hash[32], stored[32];
+    CRYPT_DATA_BLOB blob;
+    DWORD size, prop;
+    BOOL ret, found;
+
+    context = CertCreateCertificateContext(X509_ASN_ENCODING, bigCert, sizeof(bigCert));
+    ok(context != NULL, "CertCreateCertificateContext failed: %08lx\n", GetLastError());
+    if (!context) return;
+
+    ok(IS_CERT_HASH_PROP_ID(CERT_SHA256_HASH_PROP_ID), "SHA256 is not a certificate hash property\n");
+    prop = CertEnumCertificateContextProperties(context, 0);
+    ok(!prop, "Unexpected initial property %lu\n", prop);
+
+    size = sizeof(expected);
+    ret = CryptHashCertificate(0, CALG_SHA_256, 0, context->pbCertEncoded,
+                              context->cbCertEncoded, expected, &size);
+    ok(ret, "CryptHashCertificate failed: %08lx\n", GetLastError());
+    ok(size == sizeof(expected), "Unexpected SHA256 size %lu\n", size);
+
+    /* A size-only query and a failed short-buffer query must not cache a hash. */
+    size = 0;
+    ret = CertGetCertificateContextProperty(context, CERT_SHA256_HASH_PROP_ID, NULL, &size);
+    ok(ret, "Size query failed: %08lx\n", GetLastError());
+    ok(size == sizeof(hash), "Unexpected property size %lu\n", size);
+    prop = CertEnumCertificateContextProperties(context, 0);
+    ok(!prop, "Size query cached property %lu\n", prop);
+
+    memset(hash, 0xcc, sizeof(hash));
+    size = sizeof(hash) - 1;
+    SetLastError(0xdeadbeef);
+    ret = CertGetCertificateContextProperty(context, CERT_SHA256_HASH_PROP_ID, hash, &size);
+    ok(!ret, "Short-buffer query succeeded\n");
+    ok(GetLastError() == ERROR_MORE_DATA, "Unexpected error %08lx\n", GetLastError());
+    ok(size == sizeof(hash), "Unexpected required size %lu\n", size);
+    ok(hash[0] == 0xcc && hash[sizeof(hash) - 1] == 0xcc, "Short-buffer query wrote data\n");
+    prop = CertEnumCertificateContextProperties(context, 0);
+    ok(!prop, "Short-buffer query cached property %lu\n", prop);
+
+    size = sizeof(hash);
+    ret = CertGetCertificateContextProperty(context, CERT_SHA256_HASH_PROP_ID, hash, &size);
+    ok(ret, "SHA256 property query failed: %08lx\n", GetLastError());
+    ok(size == sizeof(hash), "Unexpected property size %lu\n", size);
+    if (ret) ok(!memcmp(hash, expected, sizeof(hash)), "Unexpected SHA256 property value\n");
+
+    found = FALSE;
+    prop = 0;
+    while ((prop = CertEnumCertificateContextProperties(context, prop)))
+        if (prop == CERT_SHA256_HASH_PROP_ID) found = TRUE;
+    ok(found, "Successful SHA256 query did not cache the property\n");
+
+    memset(hash, 0xcc, sizeof(hash));
+    size = sizeof(hash);
+    ret = CertGetCertificateContextProperty(context, CERT_SHA256_HASH_PROP_ID, hash, &size);
+    ok(ret, "Cached SHA256 query failed: %08lx\n", GetLastError());
+    ok(size == sizeof(hash), "Unexpected cached property size %lu\n", size);
+    if (ret) ok(!memcmp(hash, expected, sizeof(hash)), "Unexpected cached SHA256 value\n");
+
+    size = 0;
+    ret = CertGetCertificateContextProperty(context, CERT_SHA256_HASH_PROP_ID, NULL, &size);
+    ok(ret, "Cached size query failed: %08lx\n", GetLastError());
+    ok(size == sizeof(hash), "Unexpected cached query size %lu\n", size);
+
+    memset(hash, 0xcc, sizeof(hash));
+    size = sizeof(hash) - 1;
+    SetLastError(0xdeadbeef);
+    ret = CertGetCertificateContextProperty(context, CERT_SHA256_HASH_PROP_ID, hash, &size);
+    ok(!ret, "Cached short-buffer query succeeded\n");
+    ok(GetLastError() == ERROR_MORE_DATA, "Unexpected cached query error %08lx\n", GetLastError());
+    ok(size == sizeof(hash), "Unexpected cached required size %lu\n", size);
+    ok(hash[0] == 0xcc && hash[sizeof(hash) - 1] == 0xcc, "Cached short-buffer query wrote data\n");
+
+    /* The generic BLOB setter must store, return, and remove the property. */
+    memcpy(stored, expected, sizeof(stored));
+    stored[0] ^= 0xff;
+    blob.pbData = stored;
+    blob.cbData = sizeof(stored);
+    ret = CertSetCertificateContextProperty(context, CERT_SHA256_HASH_PROP_ID, 0, &blob);
+    ok(ret, "SHA256 property setter failed: %08lx\n", GetLastError());
+    size = sizeof(hash);
+    ret = CertGetCertificateContextProperty(context, CERT_SHA256_HASH_PROP_ID, hash, &size);
+    ok(ret, "Stored SHA256 query failed: %08lx\n", GetLastError());
+    ok(size == sizeof(hash), "Unexpected stored property size %lu\n", size);
+    if (ret) ok(!memcmp(hash, stored, sizeof(hash)), "Stored SHA256 was recomputed\n");
+
+    ret = CertSetCertificateContextProperty(context, CERT_SHA256_HASH_PROP_ID, 0, NULL);
+    ok(ret, "Removing SHA256 property failed: %08lx\n", GetLastError());
+    prop = CertEnumCertificateContextProperties(context, 0);
+    ok(!prop, "Removing SHA256 left property %lu\n", prop);
+    size = sizeof(hash);
+    ret = CertGetCertificateContextProperty(context, CERT_SHA256_HASH_PROP_ID, hash, &size);
+    ok(ret, "SHA256 regeneration failed: %08lx\n", GetLastError());
+    ok(size == sizeof(hash), "Unexpected regenerated property size %lu\n", size);
+    if (ret) ok(!memcmp(hash, expected, sizeof(hash)), "Unexpected regenerated SHA256\n");
+
+    CertFreeCertificateContext(context);
+}
