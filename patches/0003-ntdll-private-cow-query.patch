+/* Observe the kernel's first-write state without removing Linux write access.
+ * This also covers writes made by read/recvmsg and by wineserver.  Unlike
+ * MEM_WRITE_WATCH, private-copy history is cumulative and must never reset. */
+static NTSTATUS sync_cow_pages( struct file_view *view )
+{
+#ifdef USE_UFFD_WRITEWATCH
+    struct page_region regions[64];
+    struct pm_scan_arg arg = { 0 };
+    char *addr;
+    size_t i;
+    int count;
+
+    if (!(view->protect & VPROT_COW_TRACKED)) return STATUS_SUCCESS;
+    arg.size = sizeof(arg);
+    arg.start = (UINT_PTR)view->base;
+    arg.end = arg.start + view->size;
+    arg.vec = (UINT_PTR)regions;
+    arg.vec_len = ARRAY_SIZE(regions);
+    arg.category_mask = PAGE_IS_WPALLOWED | PAGE_IS_WRITTEN;
+    arg.return_mask = PAGE_IS_WRITTEN;
+    while (arg.start < arg.end)
+    {
+        if ((count = ioctl( pagemap_fd, PAGEMAP_SCAN, &arg )) < 0)
+        {
+            ERR_(virtual_cow)( "PAGEMAP_SCAN failed: %s.\n", strerror(errno) );
+            return STATUS_UNSUCCESSFUL;
+        }
+        for (i = 0; i < count; ++i)
+            for (addr = (char *)(UINT_PTR)regions[i].start;
+                 addr < (char *)(UINT_PTR)regions[i].end; addr += page_size)
+            {
+                if (!(get_page_vprot( addr ) & VPROT_COPIED))
+                    TRACE_(virtual_cow)( "private page %p view %p offset %lx.\n",
+                                        addr, view->base, addr - (char *)view->base );
+                set_page_vprot_bits( addr, page_size, VPROT_COPIED, 0 );
+            }
+        if (arg.walk_end >= arg.end) break;
+        if (arg.walk_end <= arg.start) return STATUS_UNSUCCESSFUL;
+        arg.start = arg.walk_end;
+    }
+#endif
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS track_cow_range( struct file_view *view, void *base, size_t size )
+{
+#ifdef USE_UFFD_WRITEWATCH
+    struct uffdio_register reg = { 0 };
+    struct uffdio_writeprotect wp = { 0 };
+
+    if (!use_kernel_writewatch || host_page_size != page_size || !size ||
+        (view->protect & VPROT_SYSTEM)) return STATUS_SUCCESS;
+    reg.range.start = (UINT_PTR)base;
+    reg.range.len = size;
+    reg.mode = UFFDIO_REGISTER_MODE_WP;
+    madvise( base, size, MADV_NOHUGEPAGE );
+    if (ioctl( uffd_fd, UFFDIO_REGISTER, &reg ) < 0)
+    {
+        ERR_(virtual_cow)( "register %p size %lx failed: %s.\n", base, size, strerror(errno) );
+        return STATUS_NOT_SUPPORTED;
+    }
+    wp.range = reg.range;
+    wp.mode = UFFDIO_WRITEPROTECT_MODE_WP;
+    if (!(reg.ioctls & (1ull << _UFFDIO_WRITEPROTECT)) ||
+        ioctl( uffd_fd, UFFDIO_WRITEPROTECT, &wp ) < 0)
+    {
+        ERR_(virtual_cow)( "arm %p size %lx failed: %s.\n", base, size, strerror(errno) );
+        ioctl( uffd_fd, UFFDIO_UNREGISTER, &reg.range );
+        return STATUS_NOT_SUPPORTED;
+    }
+    view->protect |= VPROT_COW_TRACKED;
+    TRACE_(virtual_cow)( "armed %p size %lx view %p.\n", base, size, view->base );
+#endif
+    return STATUS_SUCCESS;
+}
